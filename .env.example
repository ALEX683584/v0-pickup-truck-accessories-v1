# The canonical public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.tobekin.com

# ──────────────────────────────────────────────
# Contact Form — Email Delivery
# ──────────────────────────────────────────────
# Option A: Resend (preferred)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Option B: SMTP fallback (used if RESEND_API_KEY is not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Target Email & Webhook / Worker Endpoints
CONTACT_EMAIL=auto683584alex@gmail.com
CF_WORKER_URL=https://inquiry.tobekin.com
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/25ae59af-a5e0-47e0-9ede-1902f0e7735b
